---
// EDIT: numbers shown at the top
const stats = [
    { value: "3", label: "Years in ¡Supérate!" },
    { value: "3", label: "¡Supérate! projects" },
    { value: "3", label: "Module courses" },
    { value: "2", label: "Extra certificates" },
];

const sections = [
    { href: "/about", label: "About", desc: "Who I am, my education and my strengths." },
    { href: "/stack", label: "Tech Stack", desc: "Languages, frameworks and tools I use." },
    { href: "/projects", label: "Projects", desc: "One ¡Supérate! project per year, with my role and evidence." },
    { href: "/certificates", label: "Certificates", desc: "Module courses and extra diplomas." },
    { href: "/reflection", label: "Reflection", desc: "My progress, challenges and goals." },
    { href: "/contact", label: "Contact", desc: "Let's talk: form, email and social links." },
];
---

<section class="mx-auto max-w-6xl px-6 pb-24">
    <h2 class="reveal text-xs tracking-[0.3em] text-muted">PORTFOLIO AT A GLANCE</h2>

    <ul class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4">
        {
            stats.map((s) => (
                <li class="reveal rounded-2xl border border-line bg-fg/5 p-6">
                    <p class="text-4xl font-bold">{s.value}</p>
                    <p class="mt-2 text-sm text-muted">{s.label}</p>
                </li>
            ))
        }
    </ul>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
            sections.map((n) => (
                <a
                    href={n.href}
                    class="reveal group rounded-2xl border border-line p-6 transition duration-300 hover:-translate-y-1 hover:border-fg"
                >
                    <div class="flex items-center justify-between">
                        <h3 class="font-semibold">{n.label}</h3>
                        <span aria-hidden="true" class="transition group-hover:translate-x-1">→</span>
                    </div>
                    <p class="mt-3 text-sm leading-7 text-muted">{n.desc}</p>
                </a>
            ))
        }
    </div>
</section>