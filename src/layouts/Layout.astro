---
import "../styles/global.css";
const { title = "My Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" sizes="32x32" />

        <!-- Apply the saved theme before first paint to avoid a flash -->
        <script is:inline>
            document.documentElement.classList.add("js");
            try {
                const t = localStorage.getItem("theme");
                if (t) document.documentElement.dataset.theme = t;
            } catch {}
        </script>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link
            href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body class="font-sans antialiased">
        <!-- Living background -->
        <canvas id="bg-canvas" aria-hidden="true"></canvas>
        <div id="bg-grid" aria-hidden="true"></div>
        <div id="bg-vignette" aria-hidden="true"></div>

        <!-- Custom cursor -->
        <div id="cursor-ring" class="cursor-ring" aria-hidden="true">
            <span></span>
        </div>
        <div id="cursor-dot" class="cursor-dot" aria-hidden="true">
            <span></span>
        </div>

        <slot />

        <!-- Living background script -->
        <script is:inline>
            (function () {
                var canvas = document.getElementById("bg-canvas");
                var grid = document.getElementById("bg-grid");
                if (!canvas || !canvas.getContext) return;

                var ctx = canvas.getContext("2d");
                var root = document.documentElement;
                var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                var lowEnd = (navigator.hardwareConcurrency || 4) <= 4;

                var W = 0, H = 0, dpr = 1;
                var F = 1200;     // camera focal length
                var DEPTH = 400;  // half depth of the particle cloud
                var pts = [];
                var visList = [];
                var waves = [];
                var mouse = { x: -9999, y: -9999, active: false };
                var look = { x: 0, y: 0, tx: 0, ty: 0 };
                var scrollZ = 0;
                var lastScroll = window.pageYOffset;
                var vel = 0;
                var t = 0;
                var last = performance.now();

                // Particle color per theme
                var COL_DARK = [232, 238, 248];
                var COL_LIGHT = [18, 22, 34];
                var col = COL_DARK.slice();

                // Soft glowing orbs (colors fade between themes)
                var orbs = [
                    { sx: 0.11, sy: 0.13, p1: 0.0, p2: 1.7, r: 0.55, cd: [24, 120, 135], cl: [150, 215, 170], ad: 0.17, al: 0.32 },
                    { sx: 0.09, sy: 0.07, p1: 2.1, p2: 0.4, r: 0.50, cd: [96, 74, 210],  cl: [255, 175, 205], ad: 0.16, al: 0.30 },
                    { sx: 0.07, sy: 0.10, p1: 4.0, p2: 2.6, r: 0.60, cd: [140, 160, 50], cl: [255, 205, 160], ad: 0.12, al: 0.28 }
                ];

                function snap() {
                    var light = root.getAttribute("data-theme") === "light";
                    var tc = light ? COL_LIGHT : COL_DARK;
                    col[0] = tc[0]; col[1] = tc[1]; col[2] = tc[2];
                    orbs.forEach(function (o) {
                        o.c = (light ? o.cl : o.cd).slice();
                        o.a = light ? o.al : o.ad;
                    });
                }

                // Positions are stored as a fraction of the screen (nx, ny),
                // so they always fit the window, whatever its size
                function makePoint() {
                    return {
                        nx: (Math.random() * 2 - 1) * 0.55,
                        ny: (Math.random() * 2 - 1) * 0.6,
                        z: (Math.random() * 2 - 1) * DEPTH,
                        s: 0.6 + Math.random() * 1.4,
                        ph: Math.random() * 6.28,
                        sx: 0, sy: 0, px: 0, py: 0, a: 0, r: 1, has: false
                    };
                }

                function resize() {
                    // Measure the canvas itself (CSS makes it fill the screen)
                    var cw = canvas.clientWidth || window.innerWidth;
                    var ch = canvas.clientHeight || window.innerHeight;
                    if (cw < 2 || ch < 2) return;

                    dpr = Math.min(window.devicePixelRatio || 1, 2);
                    W = cw;
                    H = ch;
                    canvas.width = Math.round(W * dpr);
                    canvas.height = Math.round(H * dpr);
                    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

                    var n = Math.floor((W * H) / 10000);
                    if (lowEnd) n = Math.floor(n * 0.7);
                    n = Math.max(45, Math.min(135, n));
                    while (pts.length < n) pts.push(makePoint());
                    if (pts.length > n) pts.length = n;

                    if (reduce) frame(0);
                }

                function frame(dt) {
                    if (!W || !H) return;
                    var k = dt * 60;
                    t += dt;

                    var light = root.getAttribute("data-theme") === "light";
                    var tc = light ? COL_LIGHT : COL_DARK;
                    var lf = Math.min(1, 0.08 * k);
                    var c;
                    for (c = 0; c < 3; c++) col[c] += (tc[c] - col[c]) * lf;
                    var rgb = Math.round(col[0]) + "," + Math.round(col[1]) + "," + Math.round(col[2]);

                    // Smooth camera parallax
                    var pf = Math.min(1, 0.05 * k);
                    look.x += (look.tx - look.x) * pf;
                    look.y += (look.ty - look.y) * pf;

                    // Scroll velocity -> warp speed
                    var sy = window.pageYOffset;
                    var dv = sy - lastScroll;
                    lastScroll = sy;
                    vel += (dv - vel) * Math.min(1, 0.15 * k);
                    vel = Math.max(-60, Math.min(60, vel));
                    scrollZ += (0.3 + vel * 1.2) * k;
                    var warp = Math.min(1, Math.abs(vel) / 35);

                    ctx.clearRect(0, 0, W, H);

                    // ---- Orbs ----
                    orbs.forEach(function (o) {
                        var tcol = light ? o.cl : o.cd;
                        var ta = light ? o.al : o.ad;
                        for (var q = 0; q < 3; q++) o.c[q] += (tcol[q] - o.c[q]) * lf;
                        o.a += (ta - o.a) * lf;

                        var ox = W * (0.5 + 0.36 * Math.sin(t * o.sx + o.p1)) + look.x * 40;
                        var oy = H * (0.5 + 0.36 * Math.sin(t * o.sy + o.p2)) + look.y * 40;
                        var rad = Math.max(W, H) * o.r * 0.6;
                        var base = Math.round(o.c[0]) + "," + Math.round(o.c[1]) + "," + Math.round(o.c[2]);
                        var g = ctx.createRadialGradient(ox, oy, 0, ox, oy, rad);
                        g.addColorStop(0, "rgba(" + base + "," + o.a.toFixed(3) + ")");
                        g.addColorStop(1, "rgba(" + base + ",0)");
                        ctx.fillStyle = g;
                        ctx.fillRect(ox - rad, oy - rad, rad * 2, rad * 2);
                    });

                    // ---- Project particles into 2D ----
                    var yaw = Math.sin(t * 0.12) * 0.28 + look.x * 0.24;
                    var pitch = Math.sin(t * 0.09) * 0.12 - look.y * 0.16;
                    var cy_ = Math.cos(yaw), sy_ = Math.sin(yaw);
                    var cp = Math.cos(pitch), sp = Math.sin(pitch);
                    var cx = W / 2, cyy = H / 2;
                    var span = DEPTH * 2;
                    var i, p;

                    visList.length = 0;
                    for (i = 0; i < pts.length; i++) {
                        p = pts[i];
                        var zz = (((p.z + scrollZ + DEPTH) % span) + span) % span - DEPTH;
                        var x0 = p.nx * W + Math.sin(t * 0.5 + p.ph) * 14;
                        var y0 = p.ny * H + Math.cos(t * 0.4 + p.ph) * 14;

                        var x1 = x0 * cy_ + zz * sy_;
                        var z1 = -x0 * sy_ + zz * cy_;
                        var y2 = y0 * cp - z1 * sp;
                        var z2 = y0 * sp + z1 * cp;

                        var d = F + z2;
                        if (d < 250) { p.has = false; continue; }

                        var sc = F / d;
                        p.sx = cx + x1 * sc;
                        p.sy = cyy + y2 * sc;

                        var near = Math.min(1, (d - 250) / 350);
                        var edge = 1 - Math.max(0, Math.min(1, (Math.abs(zz) - DEPTH * 0.8) / (DEPTH * 0.2)));
                        var bright = 0.3 + 0.7 * Math.max(0, Math.min(1, (sc - 0.6) / 0.9));
                        p.a = near * edge * bright;
                        p.r = Math.max(0.6, Math.min(3.2, p.s * sc * 1.1));
                        visList.push(p);
                    }

                    // ---- Cursor repel + click shockwaves ----
                    for (var w = waves.length - 1; w >= 0; w--) {
                        var wv = waves[w];
                        wv.t += dt;
                        wv.r = wv.t * 650;
                        wv.life = 1 - wv.t / 1.3;
                        if (wv.life <= 0) waves.splice(w, 1);
                    }

                    for (i = 0; i < visList.length; i++) {
                        p = visList[i];

                        if (mouse.active) {
                            var mdx = p.sx - mouse.x, mdy = p.sy - mouse.y;
                            var md = Math.sqrt(mdx * mdx + mdy * mdy) || 1;
                            if (md < 150) {
                                var f = 1 - md / 150;
                                p.sx += (mdx / md) * f * 22;
                                p.sy += (mdy / md) * f * 22;
                            }
                        }

                        for (var ww = 0; ww < waves.length; ww++) {
                            var wave = waves[ww];
                            var wdx = p.sx - wave.x, wdy = p.sy - wave.y;
                            var wd = Math.sqrt(wdx * wdx + wdy * wdy) || 1;
                            var diff = Math.abs(wd - wave.r);
                            if (diff < 70) {
                                var kk = (1 - diff / 70) * 36 * wave.life;
                                p.sx += (wdx / wd) * kk;
                                p.sy += (wdy / wd) * kk;
                            }
                        }
                    }

                    // ---- Warp streaks while scrolling fast ----
                    if (warp > 0.12) {
                        ctx.lineWidth = 1.2;
                        for (i = 0; i < visList.length; i++) {
                            p = visList[i];
                            if (!p.has) continue;
                            var sdx = p.sx - p.px, sdy = p.sy - p.py;
                            if (sdx * sdx + sdy * sdy > 67600) continue;
                            ctx.strokeStyle = "rgba(" + rgb + "," + (warp * 0.6 * p.a).toFixed(3) + ")";
                            ctx.beginPath();
                            ctx.moveTo(p.px, p.py);
                            ctx.lineTo(p.sx, p.sy);
                            ctx.stroke();
                        }
                    }
                    for (i = 0; i < visList.length; i++) {
                        visList[i].px = visList[i].sx;
                        visList[i].py = visList[i].sy;
                        visList[i].has = true;
                    }

                    // ---- Links between particles ----
                    var LINK = Math.min(150, Math.max(95, W * 0.09));
                    var LINK2 = LINK * LINK;
                    ctx.lineWidth = 1;
                    for (i = 0; i < visList.length; i++) {
                        var a = visList[i];
                        for (var j = i + 1; j < visList.length; j++) {
                            var b = visList[j];
                            var dx = a.sx - b.sx;
                            if (dx > LINK || dx < -LINK) continue;
                            var dy = a.sy - b.sy;
                            if (dy > LINK || dy < -LINK) continue;
                            var d2 = dx * dx + dy * dy;
                            if (d2 > LINK2) continue;
                            var al = (1 - Math.sqrt(d2) / LINK) * 0.4 * Math.min(a.a, b.a);
                            if (al < 0.01) continue;
                            ctx.strokeStyle = "rgba(" + rgb + "," + al.toFixed(3) + ")";
                            ctx.beginPath();
                            ctx.moveTo(a.sx, a.sy);
                            ctx.lineTo(b.sx, b.sy);
                            ctx.stroke();
                        }
                    }

                    // ---- The cursor is a node of the network ----
                    if (mouse.active) {
                        for (i = 0; i < visList.length; i++) {
                            p = visList[i];
                            var cdx = p.sx - mouse.x, cdy = p.sy - mouse.y;
                            var cd = Math.sqrt(cdx * cdx + cdy * cdy);
                            if (cd < 170) {
                                ctx.strokeStyle = "rgba(" + rgb + "," + ((1 - cd / 170) * 0.55 * p.a).toFixed(3) + ")";
                                ctx.beginPath();
                                ctx.moveTo(mouse.x, mouse.y);
                                ctx.lineTo(p.sx, p.sy);
                                ctx.stroke();
                            }
                        }
                    }

                    // ---- Particles ----
                    ctx.fillStyle = "rgb(" + rgb + ")";
                    for (i = 0; i < visList.length; i++) {
                        p = visList[i];
                        ctx.globalAlpha = Math.min(1, p.a * 0.95);
                        ctx.beginPath();
                        ctx.arc(p.sx, p.sy, p.r, 0, 6.2832);
                        ctx.fill();
                    }
                    ctx.globalAlpha = 1;

                    // ---- Shockwave rings ----
                    ctx.lineWidth = 1.2;
                    for (var r = 0; r < waves.length; r++) {
                        var wr = waves[r];
                        ctx.strokeStyle = "rgba(" + rgb + "," + (wr.life * 0.35).toFixed(3) + ")";
                        ctx.beginPath();
                        ctx.arc(wr.x, wr.y, wr.r, 0, 6.2832);
                        ctx.stroke();
                    }
                }

                function loop(now) {
                    var dt = Math.min(0.05, (now - last) / 1000);
                    last = now;
                    frame(dt);
                    requestAnimationFrame(loop);
                }

                // ---- Input ----
                window.addEventListener("pointermove", function (e) {
                    if (!W || !H) return;
                    look.tx = (e.clientX / W - 0.5) * 2;
                    look.ty = (e.clientY / H - 0.5) * 2;
                    if (e.pointerType === "mouse") {
                        mouse.x = e.clientX;
                        mouse.y = e.clientY;
                        mouse.active = true;
                        if (grid) {
                            grid.style.setProperty("--mx", e.clientX + "px");
                            grid.style.setProperty("--my", e.clientY + "px");
                        }
                    }
                }, { passive: true });

                root.addEventListener("mouseleave", function () {
                    mouse.active = false;
                    look.tx = 0;
                    look.ty = 0;
                    if (grid) {
                        grid.style.setProperty("--mx", "-999px");
                        grid.style.setProperty("--my", "-999px");
                    }
                });

                window.addEventListener("pointerdown", function (e) {
                    if (reduce) return;
                    waves.push({ x: e.clientX, y: e.clientY, t: 0, r: 0, life: 1 });
                    if (waves.length > 4) waves.shift();
                }, { passive: true });

                // ---- Keep the canvas sized to the screen, always ----
                if ("ResizeObserver" in window) new ResizeObserver(resize).observe(canvas);
                window.addEventListener("resize", resize);
                window.addEventListener("load", resize);
                if (window.visualViewport) {
                    window.visualViewport.addEventListener("resize", resize);
                }

                // ---- Start ----
                snap();
                resize();
                if (reduce) {
                    // No animation: draw one still frame and redraw when the theme changes
                    new MutationObserver(function () { snap(); frame(0); })
                        .observe(root, { attributes: true, attributeFilter: ["data-theme"] });
                } else {
                    requestAnimationFrame(loop);
                }
            })();
        </script>

        <!-- Custom cursor -->
        <script is:inline>
            (function () {
                var RING_SIZE = 56;
                var ring = document.getElementById("cursor-ring");
                var dot = document.getElementById("cursor-dot");
                if (!ring || !dot) return;

                // Skip only on touch-only devices
                if (window.matchMedia("(hover: none)").matches) return;

                var mx = -100, my = -100;
                var dx = mx, dy = my;
                var rx = mx, ry = my;
                var ready = false;
                var target = null;

                window.addEventListener("mousemove", function (e) {
                    mx = e.clientX;
                    my = e.clientY;
                    if (!ready) {
                        dx = rx = mx;
                        dy = ry = my;
                        ready = true;
                    }
                    ring.classList.add("is-visible");
                    dot.classList.add("is-visible");
                });

                document.documentElement.addEventListener("mouseleave", function () {
                    ring.classList.remove("is-visible");
                    dot.classList.remove("is-visible");
                    ready = false;
                });

                document.addEventListener("mouseover", function (e) {
                    var el = e.target.closest("a, button, [data-magnetic]");
                    if (el === target) return;
                    target = el;

                    var magnetic = !!el && el.hasAttribute("data-magnetic");
                    var link = !!el && !magnetic;

                    ring.classList.toggle("is-link", link);
                    ring.classList.toggle("is-magnetic", magnetic);
                    dot.classList.toggle("is-link", link);
                    dot.classList.toggle("is-hidden", magnetic);

                    if (magnetic) {
                        var r = el.getBoundingClientRect();
                        var size = Math.max(r.width, r.height) + 22;
                        ring.style.setProperty("--ring-scale", String(size / RING_SIZE));
                    } else {
                        ring.style.removeProperty("--ring-scale");
                    }
                });

                function loop() {
                    var tx = mx, ty = my;
                    if (target && target.hasAttribute("data-magnetic")) {
                        var r = target.getBoundingClientRect();
                        tx = r.left + r.width / 2;
                        ty = r.top + r.height / 2;
                    }

                    dx += (mx - dx) * 0.4;  // dot stays close to the mouse
                    dy += (my - dy) * 0.4;
                    rx += (tx - rx) * 0.15; // ring trails behind
                    ry += (ty - ry) * 0.15;

                    dot.style.transform = "translate3d(" + dx + "px," + dy + "px,0) translate(-50%,-50%)";
                    ring.style.transform = "translate3d(" + rx + "px," + ry + "px,0) translate(-50%,-50%)";
                    requestAnimationFrame(loop);
                }
                loop();
            })();
        </script>

        <!-- Reveal on scroll -->
        <script is:inline>
            (function () {
                var els = document.querySelectorAll(".reveal");
                if (!("IntersectionObserver" in window)) {
                    els.forEach(function (el) { el.classList.add("is-in"); });
                    return;
                }
                var io = new IntersectionObserver(
                    function (entries) {
                        entries.forEach(function (en) {
                            if (en.isIntersecting) {
                                en.target.classList.add("is-in");
                                io.unobserve(en.target);
                            }
                        });
                    },
                    { threshold: 0.12 }
                );
                els.forEach(function (el) { io.observe(el); });
            })();
        </script>
    </body>
</html>