---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NextLink from "../components/NextLink.astro";
import Socials from "../components/Socials.astro";

// EDIT: your email and your Formspree URL (free at formspree.io)
const email = "your@email.com";
const formEndpoint = "https://formspree.io/f/your-form-id";

const field =
    "mt-2 w-full rounded-xl border border-line bg-fg/5 px-4 py-3 text-sm text-fg outline-none transition focus:border-fg";
---

<Layout title="Contact | Leonardo López">
    <Header />
    <main class="mx-auto max-w-6xl px-6 pb-24 pt-32 md:pt-40">
        <h1 class="reveal text-5xl font-bold md:text-6xl">Contact.</h1>

        <div class="mt-14 grid gap-16 md:grid-cols-2">
            <div class="reveal">
                <p class="max-w-md leading-8 text-muted">
                    Have an idea, an opportunity or just want to say hi? Send me
                    a message and I'll get back to you as soon as I can.
                </p>

                <a
                    href={`mailto:${email}`}
                    class="mt-8 inline-block break-all border-b border-fg pb-1 text-xl font-semibold md:text-2xl"
                >
                    {email}
                </a>

                <div class="mt-10">
                    <Socials />
                </div>
            </div>

            <form id="contact-form" action={formEndpoint} method="POST" class="reveal space-y-6">
                <label class="block text-sm text-muted">
                    Name
                    <input type="text" name="name" required autocomplete="name" class={field} />
                </label>

                <label class="block text-sm text-muted">
                    Email
                    <input type="email" name="email" required autocomplete="email" class={field} />
                </label>

                <label class="block text-sm text-muted">
                    Message
                    <textarea name="message" rows="5" required class={field}></textarea>
                </label>

                <!-- Honeypot: hidden field that blocks spam bots -->
                <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" />

                <button
                    type="submit"
                    class="rounded-full bg-fg px-8 py-3 text-sm font-semibold text-bg transition hover:-translate-y-1"
                >
                    Send message
                </button>

                <p id="form-status" role="status" class="text-sm text-muted"></p>
            </form>
        </div>

        <NextLink />
    </main>
    <Footer />
</Layout>

<script>
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const status = document.getElementById("form-status");

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!status) return;
        status.textContent = "Sending…";

        try {
            const res = await fetch(form.action, {
                method: "POST",
                body: new FormData(form),
                headers: { Accept: "application/json" },
            });

            if (res.ok) {
                form.reset();
                status.textContent = "Thank you! Your message has been sent.";
            } else {
                status.textContent = "Something went wrong. Please email me directly.";
            }
        } catch {
            status.textContent = "Network error. Please email me directly.";
        }
    });
</script>