---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NextLink from "../components/NextLink.astro";
import CertCard from "../components/CertCard.astro";

/* EDIT: the 3 required courses of the module.
   image: put the diploma in public/certs/ and use "/certs/file.jpg" */
const courses = [
    { title: "Intermediate Investing: Risk Analysis and Decision-Making", issuer: "Platzi", date: "2026", href: "https://platzi.com/p/frankkalyboris/curso/2723-course/diploma/detalle/", image: "/certs/diploma-analisis-tecnico.jpg" },
    { title: "Introduction to Technical Analysis of Financial Markets", issuer: "Platzi", date: "2026", href: "https://platzi.com/p/frankkalyboris/curso/2722-course/diploma/detalle/", image: "/certs/diploma-analisis-tecnico-intro.jpg" },
    { title: "Investing in the Stock Market from Scratch", issuer: "Platzi", date: "2026", href: "https://platzi.com/p/frankkalyboris/curso/5614-course/diploma/detalle/", image: "/certs/diploma-inversion-bolsa-trii.jpg" },
];

// EDIT: extra certificates earned during the 3 years
const extra = [
    {
        title: "CSP 2026 Certification", // EDIT: official name
        issuer: "ESEN", // EDIT
        date: "2026",
        href: "/certs/csp-2026.jpg",
        image: "/certs/csp-2026.jpg",
    },
    {
        title: "Excel Expert Certification",
        issuer: "Microsoft", // EDIT
        date: "2026", // EDIT
        href: "/certs/excel-expert.jpg",
        image: "/certs/excel-expert.jpg",
    },
    {
        title: "Power BI",
        issuer: "Programa Empresarial ¡SUPÉRATE!", // EDIT
        date: "2026", // EDIT
        href: "/certs/power-bi.png",
        image: "/certs/power-bi.png",
    },
];
---

<Layout title="Certificates | Leonardo López">
    <Header />
    <main class="mx-auto max-w-6xl px-6 pb-24 pt-32 md:pt-40">
        <h1 class="reveal text-5xl font-bold md:text-6xl">Certificates.</h1>
        <p class="reveal mt-6 max-w-2xl leading-8 text-muted">
            Courses and diplomas earned during my three years of training.
        </p>

        <h2 class="reveal mt-16 text-xs tracking-[0.3em] text-muted">MODULE COURSES</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {courses.map((c) => <CertCard cert={c} />)}
        </div>

        {
            extra.length > 0 && (
                <>
                    <h2 class="reveal mt-20 text-xs tracking-[0.3em] text-muted">
                        ADDITIONAL CERTIFICATES
                    </h2>
                    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                        {extra.map((c) => <CertCard cert={c} />)}
                    </div>
                </>
            )
        }

        <NextLink />
    </main>
    <Footer />
</Layout>