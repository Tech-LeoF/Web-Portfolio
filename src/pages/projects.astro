---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NextLink from "../components/NextLink.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ProjectPanel from "../components/ProjectPanel.astro";

/* EDIT: your projects.
   - cover: image in public/projects/ (leave "" to show a placeholder)
   - images: extra screenshots in public/projects/
   - open: what the big bottom button opens */
const superate = [
    {
        slug: "valtrust",
        program: "¡Supérate! Year 3",
        year: "2026",
        title: "Valtrust",
        description:
            "A custom website that delivers objective real-estate evaluations using OCR, AI and 3D.",
        about: [
            "Valtrust brings objectivity to the real-estate sector. It combines OCR scanning, AI and interactive 3D to turn property information into clear, reliable evaluations.",
            "I founded the project, developed it with three.js and worked as SCRUM Master. It sharpened my teamwork, decision-making and problem-solving skills.",
        ],
        tags: ["three.js", "OCR Scanning", "AI", "Scrum"],
        role: "Founder, Developer & SCRUM Master",
        contributions: [
            "Founded the project and defined its vision and goals.",
            "Developed the 3D experience with three.js and the OCR scanning feature.",
            "Ran the Scrum process: sprint planning, daily check-ins and retrospectives.",
        ],
        evidence: [
            { label: "GitHub repository", href: "https://github.com/ValtrustET26/valtrust-website.git" },
            { label: "Live demo", href: "https://valtrust-website.vercel.app/" },
        ],
        cover: "/Projects/valtrust.jpeg",
        images: [] as string[],
        open: { label: "Open Project", href: "https://valtrust-website.vercel.app/" },
    },
    {
        slug: "havenup",
        program: "¡Supérate! Year 2",
        year: "2025",
        title: "HavenUp!",
        description:
            "A real-estate website that uses 3D models to showcase properties and AI to reduce uncertainty.",
        about: [
            "HavenUp! helps people explore properties through interactive 3D models, and uses AI to reduce the uncertainty of choosing a place to live.",
            "I led the team and developed the platform with Next.js, Supabase (PostgreSQL) and Tailwind CSS. The project strengthened my leadership, teamwork and critical thinking.",
        ],
        tags: ["Next.js", "Supabase", "PostgreSQL", "Tailwind CSS", "3D", "AI"],
        role: "Team Lead & Developer",
        contributions: [
            "Led the team: defined priorities, distributed tasks and kept everyone aligned.",
            "Developed the application with Next.js and designed the database in Supabase (PostgreSQL).",
            "Integrated the 3D property models and the AI features into the experience.",
        ],
        evidence: [
            { label: "GitHub repository", href: "https://github.com/Tech-LeoF/HavenUp-Website.git" },
            { label: "Live demo", href: "https://haven-up-website.vercel.app/" },
        ],
        cover: "/Projects/havenup.jpg",
        images: [] as string[],
        open: { label: "Open Project", href: "https://haven-up-website.vercel.app/" },
    },
    {
        slug: "karaoke-pip-pop",
        program: "¡Supérate! Year 1",
        year: "2024",
        title: "Karaoke Pip & Pop",
        description:
            "A web app to save your favorite songs and play them anytime, right from the browser.",
        about: [
            "Karaoke Pip & Pop is a web app where you build your own music library: save the songs you love and play them whenever you want, from any device.",
            "It was my first complete web project. I learned how to structure a site, handle user interactions and keep a collection of content organized while working with a team.",
        ],
        // EDIT: confirm the technologies and your role for this project
        tags: ["HTML5", "JavaScript", "Git & GitHub"],
        role: "Frontend Developer",
        contributions: [
            "Built the interface where users browse and manage their saved songs.",
            "Implemented the playback controls with JavaScript.",
            "Used Git and GitHub to collaborate with my teammates.",
        ],
        evidence: [
            { label: "GitHub repository", href: "https://github.com/Tech-LeoF/Pip-PopKaraoke.git" },
            { label: "Live demo", href: "https://karaoke-pip-pop.netlify.app/" },
        ],
        cover: "/Projects/pip-pop.jpeg",
        images: [] as string[],
        open: { label: "Open Project", href: "https://karaoke-pip-pop.netlify.app/" },
    },
];
---

<Layout title="Projects | Leonardo López">
    <Header />
    <main class="mx-auto max-w-6xl px-6 pb-24 pt-32 md:pt-40">
        <h1 class="reveal text-5xl font-bold md:text-6xl">Projects.</h1>
        <p class="reveal mt-6 max-w-2xl leading-8 text-muted">
            One project for each year of the ¡Supérate! program. Click a
            project to see the details.
        </p>

        <div class="mt-12 columns-1 gap-6 md:columns-2">
            {superate.map((p, i) => <ProjectCard project={p} index={i} />)}
        </div>

        <NextLink />
    </main>
    <Footer />

    {superate.map((p) => <ProjectPanel project={p} />)}
</Layout>

<script is:inline>
    (function () {
        var panels = document.querySelectorAll("[data-panel]");
        if (!panels.length) return;

        var pageParts = document.querySelectorAll("header, main, footer");
        var current = null;
        var lastTrigger = null;

        function openPanel(id, push) {
            var panel = document.getElementById(id);
            if (!panel || !panel.hasAttribute("data-panel")) return;

            if (current && current !== panel) {
                current.classList.remove("is-open");
                current.setAttribute("aria-hidden", "true");
            }
            current = panel;
            panel.classList.add("is-open");
            panel.setAttribute("aria-hidden", "false");

            pageParts.forEach(function (el) { el.setAttribute("inert", ""); });
            document.documentElement.style.overflow = "hidden";

            if (push) history.pushState({ project: id }, "", "#" + id);

            var sc = panel.querySelector("[data-scroll]");
            if (sc) sc.scrollTop = 0;
            var btn = panel.querySelector("[data-close]");
            if (btn) btn.focus({ preventScroll: true });
        }

        function closePanel() {
            if (!current) return;
            current.classList.remove("is-open");
            current.setAttribute("aria-hidden", "true");
            current = null;

            pageParts.forEach(function (el) { el.removeAttribute("inert"); });
            document.documentElement.style.overflow = "";

            if (lastTrigger) {
                lastTrigger.focus({ preventScroll: true });
                lastTrigger = null;
            }
        }

        function requestClose() {
            if (history.state && history.state.project) {
                history.back();
            } else {
                closePanel();
                if (location.hash) {
                    history.replaceState(null, "", location.pathname + location.search);
                }
            }
        }

        function sync() {
            var id = location.hash.slice(1);
            var el = id ? document.getElementById(id) : null;
            if (el && el.hasAttribute("data-panel")) {
                openPanel(id, false);
            } else {
                closePanel();
            }
        }

        document.addEventListener("click", function (e) {
            var opener = e.target.closest("[data-open]");
            if (opener) {
                e.preventDefault();
                lastTrigger = opener;
                openPanel(opener.getAttribute("data-open"), true);
                return;
            }
            if (e.target.closest("[data-close]")) requestClose();
        });

        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && current) requestClose();
        });

        window.addEventListener("popstate", sync);
        sync();
    })();
</script>