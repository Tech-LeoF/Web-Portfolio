---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NextLink from "../components/NextLink.astro";

/* EDIT: everything below. Use real stories and specific examples. */
const intro =
    "Three years ago I started this program without knowing how to code. Looking back, the biggest change is not only what I can build, but how I approach problems, work with other people and share my ideas.";

const journey = [
    {
        year: "Year 1 · 2024",
        title: "Building the foundations",
        before: "I had never written a line of code and I was afraid of making mistakes.",
        after: "I built and deployed my first responsive web app with a team.",
        learned: ["HTML & CSS", "JavaScript basics", "Git & GitHub"],
        evidence: [
            { label: "EcoTrack project", href: "/projects" },
            { label: "Course 1 diploma", href: "/certificates" },
        ],
    },
    {
        year: "Year 2 · 2025",
        title: "Designing and connecting the pieces",
        before: "I could build a page, but I did not know how to design for real users.",
        after: "I designed a full prototype in Figma and handed it off to developers.",
        learned: ["Figma & UI/UX", "React", "Working with APIs"],
        evidence: [
            { label: "StudyBuddy project", href: "/projects" },
            { label: "Course 2 diploma", href: "/certificates" },
        ],
    },
    {
        year: "Year 3 · 2026",
        title: "Leading a project end to end",
        before: "I always followed instructions and avoided speaking in front of a group.",
        after: "I led a team of five and presented the final pitch to a panel.",
        learned: ["Project management", "Databases & SQL", "Public speaking"],
        evidence: [
            { label: "LocalMarket project", href: "/projects" },
            { label: "Course 3 diploma", href: "/certificates" },
        ],
    },
];

// Self-assessed level (0-100) of each skill at the end of each year
const growth = [
    { skill: "JavaScript", levels: [35, 65, 85] },
    { skill: "UI/UX Design", levels: [10, 60, 75] },
    { skill: "Databases / SQL", levels: [5, 40, 75] },
    { skill: "Teamwork & Leadership", levels: [40, 60, 90] },
    { skill: "Public speaking", levels: [20, 45, 80] },
];

const challenges = [
    {
        title: "My first merge conflict",
        story: "During EcoTrack, two teammates and I edited the same file and the project stopped working the night before a demo.",
        learned: "I learned to use branches, write small commits and communicate before touching shared files.",
    },
    {
        title: "Speaking in public",
        story: "In Year 1, my hands shook during our first presentation and I read every slide word by word.",
        learned: "I practiced out loud, recorded myself and, by Year 3, I presented the LocalMarket pitch with only a few notes.",
    },
    {
        title: "Leading the team",
        story: "As team lead, two members were falling behind and I did not know how to ask for updates without sounding bossy.",
        learned: "I started short daily check-ins and used a Trello board so everyone could see priorities and ask for help.",
    },
];

const accomplishments = [
    "Delivered one ¡Supérate! project per year and deployed all of them online.",
    "Completed the three required module courses plus extra certificates.",
    "Led a team of five and presented the final pitch to the evaluation panel.",
    "Built this portfolio from scratch with Astro and Tailwind CSS.",
];

const goals = [
    { term: "Short term", text: "Finish my current certification and publish two more personal projects on GitHub." },
    { term: "Mid term", text: "Get my first internship as a fullstack developer and contribute to a real product." },
    { term: "Long term", text: "Grow into a developer who can lead teams and mentor students who are just starting." },
];

const opacities = [0.35, 0.65, 1];
const years = ["Y1", "Y2", "Y3"];
---

<Layout title="Reflection | Leonardo López">
    <Header />
    <main class="mx-auto max-w-6xl px-6 pb-24 pt-32 md:pt-40">
        <h1 class="reveal text-5xl font-bold md:text-6xl">Reflection.</h1>
        <p class="reveal mt-8 max-w-3xl text-lg leading-9 text-muted">{intro}</p>

        <!-- JOURNEY -->
        <h2 class="reveal mt-24 text-xs tracking-[0.3em] text-muted">MY LEARNING JOURNEY</h2>
        <div class="mt-10 max-w-3xl space-y-14 border-l border-line pl-8">
            {
                journey.map((j) => (
                    <section class="reveal relative">
                        <span class="absolute -left-[37px] top-2 h-2.5 w-2.5 rounded-full border border-fg bg-bg" />
                        <p class="text-xs tracking-[0.25em] text-muted">{j.year.toUpperCase()}</p>
                        <h3 class="mt-2 text-xl font-semibold">{j.title}</h3>

                        <div class="mt-5 grid gap-4 sm:grid-cols-2">
                            <div class="rounded-xl border border-line p-4">
                                <p class="text-xs tracking-[0.2em] text-muted">BEFORE</p>
                                <p class="mt-2 text-sm leading-7">{j.before}</p>
                            </div>
                            <div class="rounded-xl border border-fg/40 bg-fg/5 p-4">
                                <p class="text-xs tracking-[0.2em] text-muted">AFTER</p>
                                <p class="mt-2 text-sm leading-7">{j.after}</p>
                            </div>
                        </div>

                        <ul class="mt-5 flex flex-wrap gap-2 text-xs text-muted">
                            {j.learned.map((l) => (
                                <li class="rounded-full border border-line px-3 py-1">{l}</li>
                            ))}
                        </ul>

                        <ul class="mt-4 flex flex-wrap gap-4 text-sm">
                            {j.evidence.map((e) => (
                                <li>
                                    <a href={e.href} class="underline decoration-line underline-offset-4 hover:decoration-fg">
                                        {e.label} →
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </section>
                ))
            }
        </div>

        <!-- GROWTH BARS -->
        <h2 class="reveal mt-24 text-xs tracking-[0.3em] text-muted">HOW MY SKILLS GREW</h2>
        <div class="mt-10 grid gap-6 md:grid-cols-2">
            {
                growth.map((g) => (
                    <div class="reveal rounded-2xl border border-line bg-fg/5 p-6">
                        <h3 class="font-semibold">{g.skill}</h3>
                        <div class="mt-5 space-y-3">
                            {g.levels.map((lvl, i) => (
                                <div class="flex items-center gap-3 text-xs text-muted">
                                    <span class="w-6">{years[i]}</span>
                                    <div class="h-2 flex-1 overflow-hidden rounded-full bg-fg/10">
                                        <div
                                            class="bar h-full rounded-full bg-fg"
                                            style={`--w:${lvl}%; opacity:${opacities[i]}`}
                                        />
                                    </div>
                                    <span class="w-9 text-right">{lvl}%</span>
                                </div>
                            ))}
                        </div>
                    </div>
                ))
            }
        </div>

        <!-- CHALLENGES -->
        <h2 class="reveal mt-24 text-xs tracking-[0.3em] text-muted">CHALLENGES AND WHAT I LEARNED</h2>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
            {
                challenges.map((c) => (
                    <article class="reveal rounded-2xl border border-line bg-fg/5 p-6">
                        <h3 class="font-semibold">{c.title}</h3>
                        <p class="mt-4 text-xs tracking-[0.2em] text-muted">THE CHALLENGE</p>
                        <p class="mt-2 text-sm leading-7 text-muted">{c.story}</p>
                        <p class="mt-4 text-xs tracking-[0.2em] text-muted">WHAT I LEARNED</p>
                        <p class="mt-2 text-sm leading-7">{c.learned}</p>
                    </article>
                ))
            }
        </div>

        <!-- ACCOMPLISHMENTS -->
        <h2 class="reveal mt-24 text-xs tracking-[0.3em] text-muted">ACCOMPLISHMENTS</h2>
        <ul class="mt-8 max-w-3xl space-y-4">
            {
                accomplishments.map((a) => (
                    <li class="reveal flex gap-4 leading-8 text-muted">
                        <span aria-hidden="true" class="text-fg">✓</span>
                        <span>{a}</span>
                    </li>
                ))
            }
        </ul>

        <!-- GOALS -->
        <h2 class="reveal mt-24 text-xs tracking-[0.3em] text-muted">MY GOALS</h2>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
            {
                goals.map((g) => (
                    <div class="reveal rounded-2xl border border-line p-6 transition duration-300 hover:-translate-y-1 hover:border-fg">
                        <p class="text-xs tracking-[0.25em] text-muted">{g.term.toUpperCase()}</p>
                        <p class="mt-4 leading-8">{g.text}</p>
                    </div>
                ))
            }
        </div>

        <NextLink />
    </main>
    <Footer />
</Layout>

<style>
    /* Bars fill up when they scroll into view */
    .bar {
        width: var(--w);
        transition: width 1.2s cubic-bezier(0.22, 1, 0.36, 1);
    }
    :global(.js) .reveal:not(.is-in) .bar {
        width: 0;
    }
</style>